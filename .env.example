# Copy to .env.local for development. Never commit real values.

# Postgres (Neon pooled connection string in production; local cluster in dev)
DATABASE_URL=postgres://user:password@127.0.0.1:55432/speedat_dev

# Firebase Auth (admin sign-in). Web config is public; the service account is NOT.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# JSON of the service account, base64-encoded, for server-side token verification
FIREBASE_SERVICE_ACCOUNT_B64=

# Shared secret the inbound-email webhook must present. Postmark: set the inbound
# webhook URL to https://anything:<secret>@<host>/api/inbound/email ; other providers
# can send it as an `x-inbound-secret` header.
INBOUND_EMAIL_SECRET=

# Shared secret for Vercel Cron endpoints; also accepted by /api/metrics unless METRICS_TOKEN is set
CRON_SECRET=
METRICS_TOKEN=
# Days without a publish before the "rates are stale" alert (default 7)
RATES_STALE_DAYS=7
# Alert when prices have been on hold (hidden from the site) for this many hours
HOLD_ALERT_HOURS=12

# Optional error tracking (Sentry). Leave blank to keep errors in the logs only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Development only: open /admin as this address without Firebase. The address must
# still exist in the admins table (ADMIN_EMAIL=... pnpm db:seed). Ignored in production builds.
# DEV_ADMIN_EMAIL=

# Optional: scratch database for the integration tests (migrated and emptied by the tests)
# TEST_DATABASE_URL=postgres://user:password@127.0.0.1:55432/speedat_test

# Signs public-form tokens, encrypts admin TOTP secrets (unless TOTP_ENCRYPTION_KEY is set) and
# hashes IPs. Any long random string; keep it stable — rotating it invalidates enrolled 2FA.
APP_SECRET=
TOTP_ENCRYPTION_KEY=
IP_HASH_SALT=

# Outbound email to the office (Postmark). Leave blank to log instead of sending.
POSTMARK_SERVER_TOKEN=
NOTIFY_FROM=alerts@speedat.net
OFFICE_EMAIL=info@speedat.net

# Public site origin, used in metadata and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
